{
  "name": "@huggies/shit-bin",
  "description": "💩 constants for shit defi activity",
  "version": "0.0.4",
  "homepage": "https://huggies.near.page/",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "browser": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/huggiesdotnear/shit-bin.git"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rm -f .tsbuildinfo && bun run tsc",
    "clean": "rm -rf dist .tsbuildinfo",
    "version:sync": "bun run scripts/version-sync.ts",
    "version:dry-run": "bun run scripts/version-sync.ts --dry-run",
    "release:version": "bun run scripts/release-version.ts"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "typescript": "^7.0.2",
    "@near-kit-tool-box/env": "^0.3.0"
  },
  "peerDependenciesMeta": {
    "@near-kit-tool-box/env": {
      "optional": true
    }
  },
  "dependencies": {
    "@near-kit-tool-box/env": "^0.3.0",
    "@near-kit-tool-box/fun": "^0.3.0",
    "@near-kit-tool-box/web": "^0.3.0",
    "near-kit": "^0.20.2",
    "prettier": "^3.8.3"
  }
}
